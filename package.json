{
  "name": "rentwise-ai",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev\" \"cd backend && c:/rental-searching-app/.venv/Scripts/python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000\"",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test:api": "cd backend && c:/rental-searching-app/.venv/Scripts/python.exe -m pytest -q tests",
    "docker:up": "docker compose up --build",
    "start:api": "cd backend && c:/rental-searching-app/.venv/Scripts/python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start:web": "npm --prefix frontend run start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
